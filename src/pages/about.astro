---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="About | Muthuneth Opticals"
  description="Learn more about Muthuneth Opticals."
>
  <main class="mx-auto max-w-7xl px-6 py-24 lg:px-8">
    <div class="max-w-3xl">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-blue-700">
        About us
      </p>

      <h1 class="mt-4 text-4xl font-semibold tracking-tight text-gray-950 sm:text-5xl">
        Muthuneth Opticals
      </h1>

      <p class="mt-6 text-lg leading-8 text-gray-600">
        We provide optical and eye care related services and products
        for our customers.
      </p>
    </div>
  </main>
</Layout>