---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Contact | Muthuneth Opticals"
  description="Contact Muthuneth Opticals for eye care and optical services."
>
  <main class="mx-auto max-w-7xl px-6 py-24 lg:px-8">
    <div class="max-w-3xl">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-blue-700">
        Contact
      </p>

      <h1 class="mt-4 text-4xl font-semibold tracking-tight text-gray-950 sm:text-5xl">
        Visit or contact us
      </h1>

      <p class="mt-6 text-lg leading-8 text-gray-600">
        Get in touch with Muthuneth Opticals for more information
        about our services and products.
      </p>
    </div>
  </main>
</Layout>