---
import { business } from "../data/business";
---

<footer class="bg-blue-950 text-blue-50">
  <div class="mx-auto max-w-7xl px-6 py-12 sm:px-8 lg:px-12">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4 lg:gap-8">

      <!-- Brand -->
      <div>
        <h2 class="text-xl font-bold tracking-tight text-white">
          {business.name}
        </h2>

        <p class="mt-4 max-w-xs text-sm leading-6 text-blue-100/70">
          Quality eye care, eyewear and contact lenses for clear vision
          and everyday comfort.
        </p>

        <div class="mt-5 flex items-center gap-4">
          {business.social.facebook && (
            <a
              href={business.social.facebook}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Visit ${business.name} on Facebook`}
              class="transition-opacity hover:opacity-70"
            >
              <img
                src="/icons/facebook.svg"
                alt=""
                width="20"
                height="20"
                class="h-5 w-5"
              />
            </a>
          )}

          <a
            href={`https://wa.me/${business.whatsapp}`}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Contact ${business.name} on WhatsApp`}
            class="transition-opacity hover:opacity-70"
          >
            <img
              src="/icons/whatsapp.svg"
              alt=""
              width="20"
              height="20"
              class="h-5 w-5"
            />
          </a>
        </div>
      </div>

      <!-- Quick Links -->
      <div>
        <h3
          class="text-sm font-semibold uppercase tracking-[0.12em] text-white"
        >
          Quick Links
        </h3>

        <nav class="mt-4 flex flex-col gap-3 text-sm">
          <a
            href="/"
            class="w-fit text-blue-100/70 transition-colors hover:text-white"
          >
            Home
          </a>

          <a
            href="/services"
            class="w-fit text-blue-100/70 transition-colors hover:text-white"
          >
            Services
          </a>

          <a
            href="/about"
            class="w-fit text-blue-100/70 transition-colors hover:text-white"
          >
            About Us
          </a>

          <a
            href="/contact"
            class="w-fit text-blue-100/70 transition-colors hover:text-white"
          >
            Contact
          </a>
        </nav>
      </div>

      <!-- Contact -->
      <div>
        <h3
          class="text-sm font-semibold uppercase tracking-[0.12em] text-white"
        >
          Contact
        </h3>

        <div class="mt-4 flex flex-col gap-4 text-sm">
          <a
            href={`tel:${business.phones.primary.replace(/\s/g, "")}`}
            class="flex items-center gap-3 text-blue-100/70 transition-colors hover:text-white"
          >
            <img
              src="/icons/phone.svg"
              alt=""
              width="18"
              height="18"
              class="h-4.5 w-4.5 shrink-0 brightness-0 invert"
            />

            <span>{business.phones.primary}</span>
          </a>

          <a
            href={`tel:${business.phones.secondary.replace(/\s/g, "")}`}
            class="flex items-center gap-3 text-blue-100/70 transition-colors hover:text-white"
          >
            <img
              src="/icons/phone.svg"
              alt=""
              width="18"
              height="18"
              class="h-4.5 w-4.5 shrink-0 brightness-0 invert"
            />

            <span>{business.phones.secondary}</span>
          </a>
        </div>
      </div>

      <!-- Locations & Hours -->
      <div>
        <h3
          class="text-sm font-semibold uppercase tracking-[0.12em] text-white"
        >
          Visit Us
        </h3>

        <div class="mt-4 flex flex-col gap-5 text-sm">
          {business.branches.map((branch) => (
            <div class="flex gap-3">
              <img
                src="/icons/location.svg"
                alt=""
                width="18"
                height="18"
                class="mt-0.5 h-4.5 w-4.5 shrink-0 brightness-0 invert"
              />

              <div>
                <p class="font-medium text-white">
                  {branch.name}
                </p>

                <p class="mt-1 leading-5 text-blue-100/70">
                  {branch.address}
                </p>
              </div>
            </div>
          ))}

          <div class="flex gap-3">
            <img
              src="/icons/clock.svg"
              alt=""
              width="18"
              height="18"
              class="mt-0.5 h-4.5 w-4.5 shrink-0 brightness-0 invert"
            />

            <div>
              <p class="font-medium text-white">
                Opening Hours
              </p>

              <p class="mt-1 text-blue-100/70">
                {business.hours.open} – {business.hours.close}
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom bar -->
    <div
      class="mt-10 flex flex-col gap-3 border-t border-blue-900 pt-6 text-xs text-blue-100/50 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>
        © {new Date().getFullYear()} {business.name}. All rights reserved.
      </p>

      <div class="flex gap-5">
        <a
          href="/privacy"
          class="transition-colors hover:text-blue-100"
        >
          Privacy Policy
        </a>

        <a
          href="/terms"
          class="transition-colors hover:text-blue-100"
        >
          Terms
        </a>
      </div>
    </div>
  </div>
</footer>
